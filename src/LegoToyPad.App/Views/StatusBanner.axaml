<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LegoToyPad.App.ViewModels"
             x:Class="LegoToyPad.App.Views.StatusBanner"
             x:DataType="vm:StatusMessage">
    <Border Classes="banner"
            Classes.success="{Binding IsSuccess}"
            Classes.warning="{Binding IsWarning}"
            Classes.error="{Binding IsError}">
        <Grid ColumnDefinitions="Auto,*">
            <Panel Width="20" Height="20" Margin="0,1,12,0" VerticalAlignment="Top">
                <PathIcon Classes="info" Data="{StaticResource IconInfo}" IsVisible="{Binding IsInfo}" />
                <PathIcon Classes="success" Data="{StaticResource IconSuccess}" IsVisible="{Binding IsSuccess}" />
                <PathIcon Classes="warning" Data="{StaticResource IconWarning}" IsVisible="{Binding IsWarning}" />
                <PathIcon Classes="error" Data="{StaticResource IconError}" IsVisible="{Binding IsError}" />
            </Panel>
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
                <SelectableTextBlock Text="{Binding Detail}" TextWrapping="Wrap" IsVisible="{Binding HasDetail}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
