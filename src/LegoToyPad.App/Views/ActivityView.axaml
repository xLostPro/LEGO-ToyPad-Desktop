<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LegoToyPad.App.ViewModels"
             x:Class="LegoToyPad.App.Views.ActivityView"
             x:DataType="vm:ActivityViewModel">
    <Grid RowDefinitions="Auto,*" Margin="32,28">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Spacing="4">
                <TextBlock Classes="h1" Text="Activity" />
                <TextBlock Classes="secondary" TextWrapping="Wrap"
                           Text="Every step the app takes with the ToyPad. Useful when a write or reset doesn't go as expected." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{Binding CopyCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconCopy}" Width="14" Height="14" />
                        <TextBlock Text="Copy all" />
                    </StackPanel>
                </Button>
                <Button Content="Clear" Command="{Binding ClearCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Classes="card" Padding="4">
            <ListBox x:Name="LogList" ItemsSource="{Binding Shell.Log}" Background="Transparent" AutomationProperties.Name="Activity log">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="12,5" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LogEntryViewModel">
                        <Grid ColumnDefinitions="Auto,Auto,*" AutomationProperties.Name="{Binding}">
                            <TextBlock Text="{Binding Time}" Classes="caption mono" FontSize="12" Margin="0,1,12,0" />
                            <Panel Grid.Column="1" Width="14" Height="14" Margin="0,2,10,0" VerticalAlignment="Top"
                                   ToolTip.Tip="{Binding LevelText}">
                                <PathIcon Classes="info" Data="{StaticResource IconInfo}" IsVisible="{Binding IsInfo}" Width="14" Height="14" />
                                <PathIcon Classes="success" Data="{StaticResource IconSuccess}" IsVisible="{Binding IsSuccess}" Width="14" Height="14" />
                                <PathIcon Classes="warning" Data="{StaticResource IconWarning}" IsVisible="{Binding IsWarning}" Width="14" Height="14" />
                                <PathIcon Classes="error" Data="{StaticResource IconError}" IsVisible="{Binding IsError}" Width="14" Height="14" />
                            </Panel>
                            <SelectableTextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" Classes="mono" FontSize="13" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
