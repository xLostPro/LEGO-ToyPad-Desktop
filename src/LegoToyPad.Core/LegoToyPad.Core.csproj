<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LegoToyPad.Core</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\charactermap.json" LogicalName="LegoToyPad.Core.Data.charactermap.json" />
    <EmbeddedResource Include="Data\tokenmap.json" LogicalName="LegoToyPad.Core.Data.tokenmap.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LegoToyPad.Core.Tests" />
  </ItemGroup>

</Project>
